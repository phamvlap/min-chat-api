# API environment
ENVIRONMENT=development

# Django secret key
DJANGO_SECRET_KEY=change-me-to-a-secure-key
DEBUG=True
ALLOWED_HOSTS=*

# Database configuration
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=your-db-hostname
DB_PORT=6543

# Clerk configuration
CLERK_API_URL=https://api.clerk.com
CLERK_JWKS_URL=https://your-clerk-domain/.well-known/jwks.json
CLERK_SECRET_KEY=your-clerk-secret-key
CLERK_ISSUER=https://your-clerk-domain

# Redis configuration
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=your-redis-password
REDIS_USE_SSL=True

# Supabase configuration
SUPABASE_PROJECT_URL=https://your-supabase-project.supabase.co

# Supabase storage configuration
SUPABASE_S3_ENDPOINT_URL=https://your-supabase-project.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=your-supabase-s3-region
SUPABASE_S3_ACCESS_KEY_ID=your-supabase-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-supabase-s3-secret-access-key
SUPABASE_S3_PRIVATE_BUCKET=your-private-bucket-name
SUPABASE_S3_PUBLIC_BUCKET=your-public-bucket-name
